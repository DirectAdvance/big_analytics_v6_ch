# sqlfluff — гейт на SQL-файлы пайплайна v6 (ClickHouse).
# Список правил и обоснование — тот же, что в work/big_analytics_v5/.sqlfluff.
# Отличие одно: диалект. Держать копией, а не общим конфигом: v5 и v6 — разные
# git-репозитории, общий файл в корне не поедет вместе с ними.

# В sql/ лежат два файла на Postgres (витрины для PBI, переехали из v5). Диалект
# у них переопределён построчной директивой `-- sqlfluff:dialect:postgres` в шапке
# файла — общий конфиг остаётся про ClickHouse, которым v6 и является.

[sqlfluff]
dialect = clickhouse
# Сняты намеренно, по замеру на этом коде:
#   RF04 (keyword as identifier) — 24 замечания из 27 на колонки date/type/source
#         звёздной схемы. Спор об именовании, а не баг.
#   AM06 (inconsistent refs in GROUP BY/ORDER BY) — 4 из 7 оставшихся, все на
#         `ORDER BY <выражение>, <квалифицированная колонка>`. Ложные.
# Цена отказа от AM06: GROUP BY по номеру колонки вперемешку с именем не ловится.
rules = AL04,AL05,AL08,AL09,AM04,AM07,AM08,CV05,CV08,CV12,RF01,ST01,ST02,ST03,ST04,ST10,ST11
# 01_init_schema.sql — 48 КБ, при потолке по умолчанию (20 КБ) он молча пропускался.
large_file_skip_byte_limit = 200000
